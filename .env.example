# AES-256-GCM 32-byte encryption key in hex (64 hex characters)
PII_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# HMAC-SHA256 32-byte secret key in hex (64 hex characters)
PHONE_HMAC_KEY=fedcba9876543210fedcba9876543210fedcba9876543210fedcba9876543210

# Database URL (defaults to sqlite:///data/pipeline.db)
DATABASE_URL=sqlite:///data/pipeline.db
